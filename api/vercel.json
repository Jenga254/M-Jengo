{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://m-jengo-backend.vercel.app/api/$1",
      "has": [
        {
          "type": "host",
          "value": "m-jengo-7cq2-frontend.vercel.app"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "outputDirectory": "public"
}
